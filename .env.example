# Copy to .env and adjust for local development.

# Random 32+ char string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only

# SQLite by default for local/demo use, per PROGRAM_REQUIREMENTS.md 10.1.
DATABASE_URL=sqlite:///./ethicalhawk.db

ENVIRONMENT=development

# Passive-recon safety controls (section 10.3)
ADAPTER_TIMEOUT_SECONDS=8
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_ADAPTERS_PER_JOB=3
RUNS_PER_USER_PER_HOUR=5
RECON_KILL_SWITCH=false

# Contact email sent in the User-Agent to SEC EDGAR, as its fair-access policy requires
# (https://www.sec.gov/os/accessing-edgar-data). Leave blank to disable the SEC source.
SEC_CONTACT_EMAIL=
